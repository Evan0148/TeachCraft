<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ClassBlock.App"
        x:Class="ClassBlock.App.ClassBlockWindow"
        x:DataType="app:ClassBlockViewModel"
        Title="时序 · ClassBlock"
        Width="1440" Height="920"
        MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">
    <Design.DataContext>
        <app:ClassBlockViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.chart-card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="#9C9585" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.top">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="ListBox.classes">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem:pointerover">
            <Setter Property="Background" Value="#F7F4EB" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem:selected">
            <Setter Property="Background" Value="#F1EEE5" />
        </Style>
        <Style Selector="Border.class-badge">
            <Setter Property="Background" Value="#F7F4EB" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="38" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="4"
                            Background="#0DD97757" BorderBrush="#8CC6613F" BorderThickness="1">
                        <TextBlock Text="时" FontFamily="{StaticResource SerifFont}" FontSize="19"
                                   Foreground="{StaticResource AccentDeepBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="时序" FontFamily="{StaticResource SerifFont}" FontSize="19"
                                   LetterSpacing="3" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="CLASSBLOCK" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                   LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Width="1" Height="30" Background="{StaticResource LineBrush}" Margin="7,0" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" />
                    <Border Classes="chip" VerticalAlignment="Center">
                        <TextBlock Text="课堂应用" FontSize="9.5" Foreground="#6B6557" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="primary top" Content="导入总表" Click="OnImportMaster"
                            IsEnabled="{Binding IsIdle}" AutomationProperties.Name="导入总表" />
                    <Button Classes="ghost top" Content="打印" Click="OnPrint"
                            IsEnabled="{Binding HasSelection}" AutomationProperties.Name="打印课程表" />
                    <Button Classes="ghost top" Content="导出图片" Click="OnExportImage"
                            IsEnabled="{Binding HasSelection}" AutomationProperties.Name="导出课程表图片" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="288,*,330" ColumnSpacing="14" Margin="16,14">
            <!-- 总表与班级 -->
            <Border Grid.Column="0" Classes="panel" Padding="13">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="9">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="总表" FontFamily="{StaticResource SerifFont}" FontSize="17"
                                       Foreground="{StaticResource InkBrush}" />
                            <Border Classes="chip" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ClassCountLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="#6B6557" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SourceName}" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   MaxWidth="128" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SourceName}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="{Binding MasterSummary}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9.5" LetterSpacing="0.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="选择下面任一班级，课程表会自动生成。" FontSize="9.5"
                                   Foreground="#A29C8C" />
                    </StackPanel>

                    <Border Grid.Row="2" IsVisible="{Binding HasWarnings}" Background="#FDF6F2"
                            BorderBrush="#E9C4B6" BorderThickness="1" CornerRadius="6" Padding="9,7">
                        <TextBlock Text="{Binding WarningText}" FontSize="9.5" LineHeight="15"
                                   Foreground="{StaticResource AccentDeepBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBox Grid.Row="3" Classes="search" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="搜索班级 / 班主任" />

                    <Grid Grid.Row="4">
                        <ListBox Classes="classes" ItemsSource="{Binding FilteredClasses}"
                                 SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:ClassItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"
                                          AutomationProperties.Name="{Binding AutomationName}">
                                        <Border Classes="class-badge" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9.5" Foreground="#6B6557"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="9.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding IsClassListEmpty}" Spacing="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClassEmptyText}" FontFamily="{StaticResource SerifFont}"
                                       FontSize="15" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="导入总表后，这里会出现各班。" FontSize="10"
                                       Foreground="#A29C8C" HorizontalAlignment="Center" />
                            <Button Classes="primary" Content="导入总表" Click="OnImportMaster"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="5" Text="课表会沿用总表里的节次、课服、午学与晚修信息。"
                               Classes="helper" />
                </Grid>
            </Border>

            <!-- 课程表 -->
            <Border Grid.Column="1" Classes="chart-card">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Border IsVisible="{Binding IsEmptyState}" Background="#F2FAF9F5"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="还没有总表" FontFamily="{StaticResource SerifFont}" FontSize="26"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="导入课程总表后，软件会自动识别年级、学期与全部班级。"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <Button Classes="primary" Content="导入总表" Click="OnImportMaster"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsSelectPrompt}" Background="#F2FAF9F5"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="选择一个班级" FontFamily="{StaticResource SerifFont}" FontSize="24"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="从左侧班级列表里选中目标班级，课程表会立即出现在这里。"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 设置 -->
            <Border Grid.Column="2" Classes="panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" Spacing="11">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="课程表标题" />
                                <TextBox Classes="field" Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="例如：九（6）班课程表" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <CheckBox IsChecked="{Binding ShowTeachers, Mode=TwoWay}"
                                          Content="在课程格里显示任课教师" FontSize="11" />
                                <TextBlock Text="关闭时只显示学科，版式与打印出来的课表一致。"
                                           Classes="helper" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="section-title" Text="显示内容" />
                                <CheckBox IsChecked="{Binding ShowEarlyReading, Mode=TwoWay}"
                                          Content="早读" FontSize="11" />
                                <CheckBox IsChecked="{Binding ShowLunchStudy, Mode=TwoWay}"
                                          Content="午学" FontSize="11" />
                                <CheckBox IsChecked="{Binding ShowAfterSchool, Mode=TwoWay}"
                                          Content="课后服务" FontSize="11" />
                                <CheckBox IsChecked="{Binding ShowEveningStudy, Mode=TwoWay}"
                                          Content="新闻联播与晚修" FontSize="11" />
                                <TextBlock Text="大课间、午餐与晚餐是固定休息行，始终保留。"
                                           Classes="helper" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="识别结果" />
                                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="6">
                                    <TextBlock Classes="field-label" Text="年级" />
                                    <TextBlock Grid.Column="1" Text="{Binding GradeText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="1" Classes="field-label" Text="学期" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TermText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="2" Classes="field-label" Text="月份" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MonthText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="3" Classes="field-label" Text="课程表" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SheetText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="4" Classes="field-label" Text="班级数" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ClassCountLabel}"
                                               FontSize="11" Foreground="{StaticResource InkBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F6F0" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="总表怎么认" FontFamily="{StaticResource SerifFont}" FontSize="13"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="软件会寻找同时包含「星期一…星期五」「1—7 节」和班级行的课程表，并从同一份工作簿里读取班主任、午学、课服与晚修。"
                                           Classes="helper" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="760" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding MasterSummary}"
                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="#A29C8C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="LOCAL ONLY · 总表不上传"
                           FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           LetterSpacing="1.2" Foreground="{StaticResource MossBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
