<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MeetRoster.App"
        x:Class="MeetRoster.App.EventEditorWindow"
        x:DataType="app:EventEditorViewModel"
        Title="选择项目"
        Width="560" Height="640"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashPressedBrush}" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="选择项目" FontFamily="{StaticResource SerifFont}"
                               FontSize="19" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding AthleteName}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlotLabel}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ActionHint}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource WashBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{Binding CurrentLabel}" />
                    <TextBlock Text="{Binding CurrentText}" FontSize="12" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsGroupMode}" />
                    <StackPanel Spacing="4" IsVisible="{Binding IsGroupMode}">
                        <TextBlock Text="{Binding SelectedCountText}" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                        <ItemsControl ItemsSource="{Binding SelectedEvents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AccentWashBrush}" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="7,2"
                                            Margin="0,0,5,4">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="清空本格" Click="OnClear"
                        IsVisible="{Binding ShowClearSingle}" FontSize="10.5" Padding="10,4"
                        AutomationProperties.Name="清空本格" />
                <Button Grid.Column="1" Classes="ghost" Content="清空全部" Click="OnClear"
                        IsVisible="{Binding ShowClearGroup}" FontSize="10.5" Padding="10,4"
                        AutomationProperties.Name="清空全部已选项目" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="6" Margin="20,12,20,0">
            <TextBox Classes="search" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索项目"
                     AutomationProperties.Name="搜索项目" />
            <TextBlock Classes="helper" Text="{Binding Hint}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="20,10,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:EventChoiceViewModel">
                            <Button Classes="choice" Click="OnChoose"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="9">
                                    <Border Width="4" Height="30" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding EventName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                                   FontSize="10" Foreground="{StaticResource AccentDeepBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource PinnedBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReplaceText}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmptyText}" FontFamily="{StaticResource SerifFont}"
                           FontSize="15" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="点击项目即选入当前格并替换原项目；清空后该格回到「未报」。"
                           FontSize="10" LineHeight="15" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding !IsGroupMode}" />
                <TextBlock Text="{Binding GroupFooterHint}"
                           FontSize="10" LineHeight="15" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding IsGroupMode}" />
                <Button Grid.Column="1" Classes="primary" Content="完成" Click="OnDone" IsDefault="True"
                        FontSize="11.5" Padding="16,7" IsVisible="{Binding IsGroupMode}"
                        AutomationProperties.Name="完成选择" />
                <Button Grid.Column="2" Classes="ghost" Content="取消" Click="OnCancel"
                        FontSize="11.5" Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消选择" />
            </Grid>
        </Border>
    </Grid>
</Window>
