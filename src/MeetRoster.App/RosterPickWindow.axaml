<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MeetRoster.App"
        x:Class="MeetRoster.App.RosterPickWindow"
        x:DataType="app:RosterPickViewModel"
        Title="从名单选择运动员"
        Width="520" Height="640"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashPressedBrush}" />
        </Style>
        <Style Selector="Button.choice:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="Button.choice:disabled">
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="从名单选择运动员" FontFamily="{StaticResource SerifFont}"
                               FontSize="19" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding ClassName, StringFormat='写入 {0}'}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Foreground="{StaticResource AccentDeepBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="20,12,20,0">
            <TextBox Classes="search" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索姓名或班级"
                     AutomationProperties.Name="搜索名单" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="helper" Text="{Binding ActionHint}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="link" Content="全选可见" Click="OnSelectAll" FontSize="10" />
                    <Button Classes="link" Content="清空" Click="OnClear" FontSize="10" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,10,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RosterCandidateViewModel">
                            <Button Classes="choice" Click="OnPick"
                                    IsEnabled="{Binding CanSelect}"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="9">
                                    <Border Width="4" Height="30" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding GenderLabel}" FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <Border Classes="chip" IsVisible="{Binding HasClassLabel}">
                                                <TextBlock Text="{Binding ClassLabel}" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource PinnedBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmptyText}" FontFamily="{StaticResource SerifFont}"
                           FontSize="15" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="名单只在本机读取；加入后姓名与项目仍可在表格里继续修改。"
                           FontSize="10" LineHeight="15" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="primary" Content="完成" Click="OnDone" IsDefault="True"
                        FontSize="11.5" Padding="16,7"
                        AutomationProperties.Name="完成选择" />
                <Button Grid.Column="2" Classes="ghost" Content="取消" Click="OnCancel"
                        FontSize="11.5" Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消选择" />
            </Grid>
        </Border>
    </Grid>
</Window>
