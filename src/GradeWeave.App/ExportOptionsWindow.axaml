<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GradeWeave.App"
        x:Class="GradeWeave.App.ExportOptionsWindow"
        x:DataType="app:ExportOptionsViewModel"
        Title="导出课表"
        Width="620" Height="700"
        MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="CheckBox.sheet">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="导出课表" FontFamily="{StaticResource SerifFont}"
                           FontSize="19" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding ProjectTitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
            <StackPanel Spacing="14" Margin="0,0,4,0">
                <StackPanel Spacing="5">
                    <TextBlock Classes="field-label" Text="导出格式" />
                    <ComboBox Classes="field" ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="app:ExportFormatOption">
                                <StackPanel Spacing="1" Margin="0,4">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="10" IsVisible="{Binding IsExcel}">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="field-label" Text="Excel 样式" />
                        <ComboBox Classes="field" ItemsSource="{Binding Styles}"
                                  SelectedItem="{Binding SelectedStyle, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="app:ExportStyleOption">
                                    <StackPanel Spacing="1" Margin="0,4">
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Spacing="4" IsVisible="{Binding IsReferenceStyle}">
                            <TextBlock Classes="field-label" Text="本机样式名称" />
                            <TextBox Classes="field" Text="{Binding ReferenceStyleName, Mode=TwoWay}"
                                     PlaceholderText="例如：参考校样式" />
                            <TextBlock Classes="helper"
                                       Text="名称只保存在本机，不写入导出文件、工程或仓库。" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{StaticResource WashBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="7">
                            <TextBlock Text="包含分页" FontFamily="{StaticResource SerifFont}"
                                       FontSize="13" Foreground="{StaticResource InkBrush}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                <CheckBox Classes="sheet" Content="课程表总表"
                                          IsChecked="{Binding IncludeMaster, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1" Classes="sheet" Content="教师分工表"
                                          IsChecked="{Binding IncludeAssignment, Mode=TwoWay}" />
                                <CheckBox Grid.Row="1" Classes="sheet" Content="教师职位安排表"
                                          IsChecked="{Binding IncludeTeacherPosition, Mode=TwoWay}" />
                                <CheckBox Grid.Row="1" Grid.Column="1" Classes="sheet" Content="班级课表"
                                          IsChecked="{Binding IncludeClassSheets, Mode=TwoWay}" />
                                <CheckBox Grid.Row="2" Classes="sheet" Content="教师课表"
                                          IsChecked="{Binding IncludeTeacherSheets, Mode=TwoWay}" />
                                <CheckBox Grid.Row="2" Grid.Column="1" Classes="sheet" Content="冲突页"
                                          IsChecked="{Binding IncludeConflict, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Classes="helper"
                                       Text="参考校样式按参考工作簿生成表一分工表、表二横向课程总表和表三教师职位表；软件自带样式沿用纸墨版式。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding IsImageOrPdf}">
                    <TextBlock Classes="field-label" Text="导出对象" />
                    <Border Background="{StaticResource WashBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding TargetText}" FontSize="14"
                                       FontFamily="{StaticResource SerifFont}"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Classes="helper" Text="{Binding TargetHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                           FontSize="10.5" Foreground="{StaticResource AccentDeepBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="文件只在本机生成，不会上传。" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Content="取消" Click="OnCancel" IsCancel="True"
                            FontSize="11.5" Padding="14,7" />
                    <Button Classes="primary" Content="导出" Click="OnExport" IsDefault="True"
                            FontSize="11.5" Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
