<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GradeWeave.App"
        x:Class="GradeWeave.App.ConflictCenterWindow"
        x:DataType="app:ConflictCenterViewModel"
        Title="冲突聚合台"
        Width="880" Height="700"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ComboBox.field, TextBox.field">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Border.conflict-row">
            <Setter Property="Background" Value="#FDF6F2" />
            <Setter Property="BorderBrush" Value="#E9C4B6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="冲突聚合台" FontFamily="{StaticResource SerifFont}"
                           FontSize="20" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="按类型、班级、教师筛选；有节次的冲突可直接定位到课程格，没有节次的会定位到相关班级。"
                           FontSize="10" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.1*,1*,1*,1.3*" ColumnSpacing="9"
              Margin="20,12,20,8">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="field-label" Text="冲突类型" />
                <ComboBox Classes="field" ItemsSource="{Binding KindFilters}"
                          SelectedItem="{Binding SelectedKindFilter, Mode=TwoWay}"
                          AutomationProperties.Name="按冲突类型筛选" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="field-label" Text="班级" />
                <ComboBox Classes="field" ItemsSource="{Binding ClassFilters}"
                          SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}"
                          AutomationProperties.Name="按班级筛选冲突" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Classes="field-label" Text="教师" />
                <ComboBox Classes="field" ItemsSource="{Binding TeacherFilters}"
                          SelectedItem="{Binding SelectedTeacherFilter, Mode=TwoWay}"
                          AutomationProperties.Name="按教师筛选冲突" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="3">
                <TextBlock Classes="field-label" Text="搜索说明 / 班级 / 教师" />
                <TextBox Classes="field" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="输入关键词过滤"
                         AutomationProperties.Name="搜索冲突说明、班级或教师" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="20,0,20,8">
            <TextBlock Text="{Binding FilterSummary}" FontFamily="{StaticResource MonoFont}"
                       FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="点「定位」回到主窗口；主窗口改课后可点刷新。"
                       Classes="helper" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:ConflictGroupViewModel">
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"
                                          Margin="0,2">
                                        <Border Background="#FBF1EA" BorderBrush="#E3B7A4"
                                                BorderThickness="1" CornerRadius="3" Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}" FontSize="10"
                                                       Foreground="{StaticResource AccentDeepBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Meta}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource AccentDeepBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,3,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="app:ConflictItemViewModel">
                                            <Border Classes="conflict-row">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Message}" FontSize="10.5"
                                                                   LineHeight="16" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource InkSoftBrush}" />
                                                        <TextBlock Text="{Binding DisplayLocation}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="ghost"
                                                            Content="{Binding ActionText}"
                                                            Click="OnLocateConflict" Tag="{Binding}"
                                                            IsEnabled="{Binding CanNavigate}"
                                                            FontSize="10" Padding="9,4"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="定位该冲突" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="没有匹配的冲突" FontFamily="{StaticResource SerifFont}" FontSize="16"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="换一个类型、班级或关键词试试。"
                           FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="冲突只提示，不会自动改课。锁定满意的课程后再重新生成，可保留手工调整。"
                           Classes="helper" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Content="刷新" Click="OnRefresh" FontSize="10.5"
                            Padding="12,6" AutomationProperties.Name="刷新冲突列表" />
                    <Button Classes="primary" Content="关闭" Click="OnClose" FontSize="10.5"
                            Padding="14,6" IsCancel="True" AutomationProperties.Name="关闭冲突聚合台" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
