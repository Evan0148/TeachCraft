<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GradeWeave.App"
        x:Class="GradeWeave.App.LessonEditorWindow"
        x:DataType="app:LessonEditorViewModel"
        Title="放入课程"
        Width="600" Height="690"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBF3EC" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7E9DF" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="放入课程" FontFamily="{StaticResource SerifFont}"
                               FontSize="19" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlotText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="点击一行即可放入" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FCFAF4" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Classes="field-label" Text="当前课程格" />
                    <TextBlock Text="{Binding CurrentText}" FontSize="12" Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="清空本格" Click="OnClear"
                        IsVisible="{Binding CanClear}" FontSize="10.5" Padding="10,4"
                        AutomationProperties.Name="清空本格" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="6" Margin="20,12,20,0">
            <TextBox Classes="search" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索学科或教师"
                     AutomationProperties.Name="搜索学科或教师" />
            <TextBlock Classes="helper"
                       Text="列表来自本班的任课关系：每行是「学科 · 任课教师」。点一行就把这节课放进当前格并替换原课；放入后会固定在这格，重新生成课表时保留。" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="20,10,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- 纵向滚动条覆盖在内容右缘上，右边距留出滚动条宽度，避免盖住行尾徽标。 -->
                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:LessonChoiceViewModel">
                            <Button Classes="choice" Click="OnChoose"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="9">
                                    <Border Width="4" Height="30" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" IsVisible="{Binding IsMain}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding SubjectName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding TeacherName}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                                   FontSize="10" Foreground="{StaticResource AccentDeepBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#F7F4EB"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReplaceText}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmptyText}" FontFamily="{StaticResource SerifFont}"
                           FontSize="15" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                <TextBlock Text="先在 05 步「编排对象」的「教师分工」里给班级填好任课教师，再回来放课。"
                           FontSize="10" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="ghost" Content="取消" Click="OnCancel"
                        FontSize="11.5" Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消放课" />
            </Grid>
        </Border>
    </Grid>
</Window>
