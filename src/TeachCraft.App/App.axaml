<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeachCraft.App.App"
             Name="知微 · TeachCraft"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- 与「分晓 · GradeStrip」共用的 Anthropic 纸墨色板 -->
        <SolidColorBrush x:Key="InkBrush" Color="#141413" />
        <SolidColorBrush x:Key="InkSoftBrush" Color="#3D3B36" />
        <SolidColorBrush x:Key="MutedBrush" Color="#85806F" />
        <SolidColorBrush x:Key="PaperBrush" Color="#FAF9F5" />
        <SolidColorBrush x:Key="PaperDeepBrush" Color="#F4F2EC" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7E3D8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#C6613F" />
        <SolidColorBrush x:Key="MossBrush" Color="#5A7A4B" />
        <SolidColorBrush x:Key="SealBrush" Color="#C6613F" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#F8F6F0" />
        <SolidColorBrush x:Key="PinnedBrush" Color="#F7F4EB" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#33141413" />

        <!-- 成绩条分档色，和 xlsx 导出保持同一套值 -->
        <SolidColorBrush x:Key="Tier1Brush" Color="#70AD47" />
        <SolidColorBrush x:Key="Tier2Brush" Color="#C6E0B4" />
        <SolidColorBrush x:Key="Tier3Brush" Color="#DDEBF7" />
        <SolidColorBrush x:Key="Tier4Brush" Color="#FFF2CC" />
        <SolidColorBrush x:Key="Tier5Brush" Color="#F8CBAD" />

        <!-- 让 Fluent 控件也用陶土色作为强调色 -->
        <Color x:Key="SystemAccentColor">#D97757</Color>
        <Color x:Key="SystemAccentColorDark1">#C6613F</Color>
        <Color x:Key="SystemAccentColorDark2">#B5543A</Color>
        <Color x:Key="SystemAccentColorDark3">#A34A36</Color>
        <Color x:Key="SystemAccentColorLight1">#E08F73</Color>
        <Color x:Key="SystemAccentColorLight2">#E7A78F</Color>
        <Color x:Key="SystemAccentColorLight3">#EFC0AF</Color>

        <FontFamily x:Key="SerifFont">avares://TeachCraft/Assets/Fonts#Anthropic Serif, SimSun, Songti SC, STSong, Noto Serif CJK SC, serif</FontFamily>
        <FontFamily x:Key="MonoFont">avares://TeachCraft/Assets/Fonts#Anthropic Mono</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Hiragino Sans GB, Noto Sans CJK SC, WenQuanYi Micro Hei, sans-serif" />
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Hiragino Sans GB, Noto Sans CJK SC, WenQuanYi Micro Hei, sans-serif" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        </Style>

        <!-- 卡片：白面 + 细边，无阴影 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style Selector="TextBlock.display">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="TextBlock.numeral">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.2" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.mono-label">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>

        <!-- 按钮基础：80ms 按压回弹 -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CircularEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="#FAF9F5" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="#FAF9F5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E2C28" />
            <Setter Property="Foreground" Value="#FAF9F5" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#000000" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DDD9CE" />
            <Setter Property="Foreground" Value="#9C978A" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#D6D1C4" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1EEE5" />
            <Setter Property="BorderBrush" Value="#BDB6A4" />
        </Style>

        <!-- 侧栏导航 -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1EEE5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1EEE5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EDE9DE" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        </Style>

        <!-- 工具卡：整卡可点，细边 + 纸感悬停 -->
        <Style Selector="Button.tool-card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CircularEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tool-card:pointerover">
            <Setter Property="Background" Value="#FEFCF7" />
            <Setter Property="BorderBrush" Value="#CFC8B6" />
        </Style>
        <Style Selector="Button.tool-card:pressed">
            <Setter Property="RenderTransform" Value="scale(0.994)" />
        </Style>
        <Style Selector="Button.tool-card:pointerover Border.tool-glyph">
            <Setter Property="Background" Value="#FBF1EA" />
            <Setter Property="BorderBrush" Value="#E3B7A4" />
        </Style>
        <Style Selector="Button.tool-card:pointerover TextBlock.tool-glyph-text">
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        </Style>
        <Style Selector="Button.tool-card:pointerover Path.tool-arrow">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.tool-card:pointerover TextBlock.arrow-glyph">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.tool-glyph">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E3DDCE" />
            <Setter Property="Background" Value="#FCFAF4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="BorderBrush" Value="#E2DCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#99FFFFFF" />
        </Style>

        <!-- 搜索框 -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="31,8,54,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#C9BFA9" />
            <Setter Property="Background" Value="#FFFEFB" />
        </Style>

        <!-- 抽屉里的投放区 -->
        <Style Selector="Button.dropzone">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dropzone:pointerover Border.dropzone-inner">
            <Setter Property="Background" Value="#F7F5EE" />
            <Setter Property="BorderBrush" Value="#BDB6A4" />
        </Style>

        <Style Selector="Border.dropzone-inner">
            <Setter Property="Background" Value="#FCFAF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Rectangle.dropzone-dash">
            <Setter Property="Stroke" Value="#D6D1C4" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeDashArray" Value="5,4" />
            <Setter Property="RadiusX" Value="9" />
            <Setter Property="RadiusY" Value="9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dropzone:pointerover Rectangle.dropzone-dash">
            <Setter Property="Stroke" Value="#BDB6A4" />
        </Style>

        <Style Selector="Button.mini">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ECE8DD" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Button.panel-close">            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.panel-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1EEE5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <!-- 表单 -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource PaperDeepBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style Selector="Border.rank-row">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.rank-row:pointerover">
            <Setter Property="Background" Value="#FBF9F3" />
        </Style>

        <Style Selector="Button.rank-seg-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.rank-seg-btn.active">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 进场淡入 -->
        <Style Selector=":is(Control).view-transition[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
