<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TeachCraft.App.ViewModels"
             x:Class="TeachCraft.App.Views.ToolPanelView"
             x:DataType="vm:ToolItemViewModel">
    <StackPanel Spacing="0">
        <!-- 眉标 + 关闭 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="18" Height="1" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                        Opacity="0.8" />
                <TextBlock Text="{Binding CategoryEn}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           LetterSpacing="2.4" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="/" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="#C9C1AE" />
                <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" LetterSpacing="0.8"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="panel-close" Click="OnClose" VerticalAlignment="Top">
                <Path Width="11" Height="11" Stretch="Uniform"
                      Data="M3,3 L11,11 M11,3 L3,11" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.4" StrokeLineCap="Round" />
            </Button>
        </Grid>

        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource SerifFont}" FontSize="32"
                   LetterSpacing="1" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                   LetterSpacing="1.3" Foreground="{StaticResource AccentDeepBrush}" Margin="0,5,0,14" />
        <TextBlock Text="{Binding Description}" FontSize="12.5" LineHeight="23" TextWrapping="Wrap"
                   Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,20" />

        <!-- 选文件 -->
        <Button Classes="dropzone" Click="OnPick" AutomationProperties.Name="选择文件">
            <Border Classes="dropzone-inner">
                <Panel>
                    <Rectangle Classes="dropzone-dash" />
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="20,22">
                        <Path Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
                              Data="M18,5 L18,21 M11,14 L18,21 L25,14 M7,26 L7,29 A2,2 0 0 0 9,31 L27,31 A2,2 0 0 0 29,29 L29,26"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <TextBlock Text="把文件拖到这里" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding InputHint}" FontSize="10.5" LetterSpacing="0.2"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>
        </Button>

        <Grid ColumnDefinitions="*,Auto" Margin="2,9,0,0">
            <TextBlock Grid.Column="0" Text="{Binding FileSummary}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />
            <Button Grid.Column="1" Classes="link" Content="清空" FontSize="10.5"
                    Foreground="{StaticResource MutedBrush}" IsVisible="{Binding HasFiles}"
                    Click="OnClearFiles" />
        </Grid>

        <!-- 多文件顺序 -->
        <ItemsControl ItemsSource="{Binding FileEntries}" IsVisible="{Binding IsMultiFile}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryViewModel">
                    <Border Background="#FCFAF4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="7,3" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="22,*,20,20,20" ColumnSpacing="2">
                            <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9" Foreground="{StaticResource AccentDeepBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10.5"
                                       Foreground="{StaticResource InkSoftBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="mini" Content="↑" Tag="{Binding}" Click="OnMoveUp" />
                            <Button Grid.Column="3" Classes="mini" Content="↓" Tag="{Binding}" Click="OnMoveDown" />
                            <Button Grid.Column="4" Classes="mini" Content="×" Tag="{Binding}" Click="OnRemoveFile" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 选项 -->
        <StackPanel Spacing="14" Margin="0,20,0,0">
            <StackPanel Spacing="6" IsVisible="{Binding ShowFormat}">
                <TextBlock Text="目标格式" FontSize="10.5" LetterSpacing="0.6"
                           Foreground="{StaticResource MutedBrush}" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ShowQuality}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="画质" FontSize="10.5" LetterSpacing="0.6"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat='{}{0:0}'}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource InkBrush}" />
                </Grid>
                <Slider Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding Quality, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding ShowResize}">
                <Grid ColumnDefinitions="*,10,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="宽度 px" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Minimum="1" Maximum="40000" Increment="10"
                                       FormatString="0" Value="{Binding WidthValue, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="高度 px" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Minimum="1" Maximum="40000" Increment="10"
                                       FormatString="0" Value="{Binding HeightValue, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="或按百分比缩放 %" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Minimum="1" Maximum="800" Increment="5"
                                       FormatString="0" Value="{Binding PercentValue, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="等比" IsChecked="{Binding KeepAspect, Mode=TwoWay}"
                              VerticalAlignment="Bottom" Margin="12,0,0,4" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding ShowCompress}">
                <TextBlock Text="最大边长 px（0 表示保持原尺寸）" FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}" />
                <NumericUpDown Minimum="0" Maximum="20000" Increment="100"
                               FormatString="0" Value="{Binding MaxEdgeValue, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding ShowWatermark}">
                <TextBlock Text="水印文字" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding WatermarkText, Mode=TwoWay}" PlaceholderText="仅供教学使用" />
                <TextBlock Text="位置" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                <ComboBox ItemsSource="{Binding WatermarkPositions}"
                          SelectedItem="{Binding SelectedWatermarkPosition, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBlock Text="字号" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding WatermarkScale, StringFormat='{}{0:0.0}×'}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource InkBrush}" />
                </Grid>
                <Slider Minimum="0.4" Maximum="3" Value="{Binding WatermarkScale, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="不透明度" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding WatermarkOpacity, StringFormat='{}{0:0.00}'}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource InkBrush}" />
                </Grid>
                <Slider Minimum="0.05" Maximum="1" Value="{Binding WatermarkOpacity, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding ShowPageRange}">
                <TextBlock Text="页码范围" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding PageRange, Mode=TwoWay}" PlaceholderText="如 1-3,5；留空则全部" />
            </StackPanel>

            <CheckBox IsVisible="{Binding ShowKeepLayout}"
                      Content="保留版面（每页渲染为图片，不可编辑）"
                      IsChecked="{Binding KeepLayout, Mode=TwoWay}" />

            <StackPanel Spacing="6" IsVisible="{Binding ShowDpi}">
                <TextBlock Text="渲染精度 DPI" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                <NumericUpDown Minimum="72" Maximum="300" Increment="25"
                               FormatString="0" Value="{Binding DpiValue, Mode=TwoWay}" />
            </StackPanel>

            <Border IsVisible="{Binding ShowPlainNote}" Background="{StaticResource PaperDeepBrush}"
                    CornerRadius="8" Padding="12,10">
                <TextBlock Text="{Binding PlainNote}" FontSize="10.5" LineHeight="18"
                           TextWrapping="Wrap" Foreground="#7E7868" />
            </Border>
        </StackPanel>

        <!-- 规格 -->
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,0" />
        <Grid ColumnDefinitions="50,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="输入" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                       Margin="0,9,0,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InputText}" FontFamily="{StaticResource MonoFont}"
                       FontSize="10.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,9,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="输出" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                       Margin="0,9,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputText}" FontFamily="{StaticResource MonoFont}"
                       FontSize="10.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,9,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="位置" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                       Margin="0,9,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="本机处理，文件不离开这台电脑" FontSize="10.5"
                       Foreground="{StaticResource InkSoftBrush}" Margin="0,9,0,0" />
        </Grid>

        <Border Background="{StaticResource PaperDeepBrush}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="0,6,8,0"
                         VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="全部处理在本机完成，文件不会上传到任何服务器。"
                           FontSize="10.5" LineHeight="18" TextWrapping="Wrap" Foreground="#7E7868" />
            </Grid>
        </Border>

        <!-- 运行 -->
        <ProgressBar IsVisible="{Binding IsBusy}" Minimum="0" Maximum="100"
                     Value="{Binding Progress}" Margin="0,18,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}" Margin="0,8,0,0">
            <TextBlock Text="正在处理…" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontFamily="{StaticResource MonoFont}"
                       FontSize="10.5" Foreground="{StaticResource AccentDeepBrush}" />
        </StackPanel>

        <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResult}" FontSize="11"
                   LineHeight="19" TextWrapping="Wrap" Foreground="{Binding ResultBrush}"
                   Margin="0,16,0,0" />

        <Button Classes="link" Content="打开所在文件夹 →" FontSize="10.5"
                Foreground="{StaticResource AccentDeepBrush}" IsVisible="{Binding HasOutput}"
                HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnOpenOutput" />

        <Button Classes="primary" Content="开始处理" AutomationProperties.Name="开始处理" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Height="40" Margin="0,14,0,0"
                IsEnabled="{Binding CanRun}" Click="OnRun" />
    </StackPanel>
</UserControl>
